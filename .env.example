# Database
DB_USER=bia
DB_PASSWORD=change_me
DB_NAME=bia_energy
# Host port for Postgres (change if a local Postgres already uses 5432)
DB_HOST_PORT=5432

# LLM, any provider as "provider/model" (e.g. gemini/gemini-3.8-flash, openai/gpt-4o-mini)
LLM_MODEL=
# Empty = template-based explanations
LLM_API_KEY=
# Max simultaneous LLM calls per engine-ai process
LLM_MAX_CONCURRENCY=4
# Seconds an analysis waits for LLM texts (retries included) before using templates
LLM_TIMEOUT_SECONDS=20

# Backend
# Comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
# engine-ai base URL; compose sets http://engine-ai:8000, `make run` uses http://localhost:8000
# AI_ENGINE_URL=http://engine-ai:8000
# Deadline for one whole analysis run (Go duration); keep well above LLM_TIMEOUT_SECONDS
AI_ENGINE_TIMEOUT=120s
# debug | info | warn | error
LOG_LEVEL=info
# Demo login (a mock: the API itself is not protected)
DEMO_USER=demo
DEMO_PASSWORD=demo

# Frontend (build time)
VITE_API_URL=http://localhost:8080
