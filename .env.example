# Database
DB_USER=bia
DB_PASSWORD=change_me
DB_NAME=bia_energy
# Host port for Postgres (change if a local Postgres already uses 5432)
DB_HOST_PORT=5432

# LLM, any provider as "provider/model" (e.g. gemini/gemini-2.0-flash, openai/gpt-4o-mini)
LLM_MODEL=
# Empty = template-based explanations
LLM_API_KEY=

# Backend
# Comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# Frontend (build time)
VITE_API_URL=http://localhost:8080
